package comp

import (
    "crow/help/strs"
    "crow/frontend/mark/comp/forms"
)

templ SoftwareMod(user *strs.User, software []strs.Software){
    <div class="w-full max-w-4xl mx-auto self-start min-h-screen">
        <div class="tabs tabs-border w-full">

            <input
                type="radio"
                name="my_tabs_2"
                class="tab"
                aria-label="Créer un Logiciel"
            />

            <div class="tab-content border-base-300 bg-base-100 p-6 md:p-10">
                @forms.CreateSoftware()
            </div>

            <input
                type="radio"
                name="my_tabs_2"
                class="tab"
                aria-label="Logiciels"
                checked="checked"
            />

            <div class="tab-content border-base-300 bg-base-100 p-6 md:p-10">
                @forms.Software(software)
            </div>

        </div>
    </div>
}