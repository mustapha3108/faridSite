package forms

import (
    "crow/help/strs"
    "fmt"
)

templ Members(members []strs.Member) {
    <div class="w-full max-w-4xl mx-auto space-y-3 p-4">
        for i, m := range members {
            @memberAccordion(m, i == 0)
        }
    </div>
}

templ memberAccordion(m strs.Member, isFirst bool) {
    <div class="collapse bg-base-100 border border-base-300 rounded-box shadow-sm">
        if isFirst {
            <input type="radio" name="member-accordion" checked="checked" />
        } else {
            <input type="radio" name="member-accordion" />
        }

        <!-- Accordion Header -->
        <div class="collapse-title font-semibold flex items-center justify-between pr-8">
            <div class="flex items-center gap-4">
                <div class="avatar">
                    <!-- Card-sized thumbnail with max-w/max-h constraints -->
                    <div class="w-24 h-24 max-w-[96px] max-h-[96px] rounded-xl overflow-hidden border border-base-300 shadow-sm shrink-0">
                        if m.MemberImagePath != "" {
                            <img src={ m.MemberImagePath } alt={ m.MemberName } class="object-cover w-full h-full" />
                        } else {
                            <div class="bg-neutral text-neutral-content flex items-center justify-center w-full h-full">
                                <span class="text-2xl uppercase font-bold">{ m.MemberName[:1] }</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="flex flex-col">
                    <span class="text-lg text-base-content font-bold leading-tight">{ m.MemberName }</span>
                    if m.MemberTitle != "" {
                        <span class="text-sm text-base-content/60 font-normal">{ m.MemberTitle }</span>
                    }
                </div>
            </div>
        </div>

        <!-- Accordion Body -->
        <div class="collapse-content text-sm space-y-6 pt-2">
            
            <!-- Update Form -->
            <form
                hx-post="/updateMember"
                hx-encoding="multipart/form-data"
                hx-target-error="#res"
                hx-swap="none"
                x-data={ fmt.Sprintf(`{
                    name: %q,
                    title: %q,
                    desc: %q,
                    previewUrl: null,
                    handleFile(e) {
                        const file = e.target.files[0];
                        if (file) {
                            this.previewUrl = URL.createObjectURL(file);
                        }
                    }
                }`, m.MemberName, m.MemberTitle, m.MemberDescription) }
                class="space-y-4 pt-2 border-t border-base-200"
            >
                <input type="hidden" name="MemberId" value={ fmt.Sprintf("%d", m.MemberId) } />
                <input type="hidden" name="MemberImagePath" value={ m.MemberImagePath } />

                <!-- Member Name -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Nom complet</span>
                    </label>
                    <input
                        type="text"
                        name="MemberName"
                        x-model="name"
                        class="input input-bordered input-sm w-full"
                        required
                        minlength="2"
                        maxlength="100"
                    />
                </div>

                <!-- Member Title -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Titre / Poste</span>
                    </label>
                    <input
                        type="text"
                        name="MemberTitle"
                        x-model="title"
                        class="input input-bordered input-sm w-full"
                        maxlength="100"
                    />
                </div>

                <!-- Member Description -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Description</span>
                    </label>
                    <textarea
                        name="MemberDescription"
                        x-model="desc"
                        class="textarea textarea-bordered textarea-sm h-24 w-full resize-none"
                        maxlength="2000"
                    ></textarea>
                </div>

                <!-- Image Upload with Card-Sized Preview -->
                <div class="form-control w-full space-y-2">
                    <label class="label pb-1">
                        <span class="label-text font-medium">Photo de profil</span>
                    </label>
                    
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 bg-base-200 p-4 rounded-xl border border-base-300">
                        <!-- Square Card Image Display -->
                        <div class="avatar shrink-0">
                            <div class="w-40 h-40 max-w-[160px] max-h-[160px] rounded-xl overflow-hidden border border-base-300 shadow-md">
                                <template x-if="previewUrl">
                                    <img :src="previewUrl" class="object-cover w-full h-full" />
                                </template>
                                <template x-if="!previewUrl">
                                    <img src={ m.MemberImagePath } class="object-cover w-full h-full" />
                                </template>
                            </div>
                        </div>

                        <div class="form-control w-full space-y-2">
                            <span class="text-xs text-base-content/70">Sélectionnez une nouvelle image pour remplacer la photo existante:</span>
                            <input
                                type="file"
                                name="MemberImage"
                                @change="handleFile($event)"
                                accept="image/*"
                                class="file-input file-input-bordered file-input-primary file-input-sm w-full"
                            />
                        </div>
                    </div>
                </div>

                <div class="flex justify-end pt-2">
                    <button type="submit" class="btn btn-primary btn-sm">
                        Mettre à jour le membre
                    </button>
                </div>
            </form>

            <!-- Delete Member -->
            <div class="pt-4 border-t border-base-200 flex justify-end">
                <div x-data="{ confirm: false }">
                    <button
                        type="button"
                        x-show="!confirm"
                        @click="confirm = true"
                        class="btn btn-error btn-outline btn-sm"
                    >
                        Supprimer le membre
                    </button>

                    <button
                        type="button"
                        x-show="confirm"
                        x-cloak
                        @click="confirm = false"
                        hx-post="/deleteMember"
                        hx-vals={ fmt.Sprintf(`{"memberId": "%d", "memberImagePath": %q}`, m.MemberId, m.MemberImagePath) }
                        hx-target="closest .collapse"
                        hx-target-error="#res"
                        hx-swap="delete"
                        class="btn btn-accent btn-sm animate-pulse font-bold"
                    >
                        Confirmer la suppression ?
                    </button>
                </div>
            </div>

        </div>
        <div id="res"></div>
    </div>
}