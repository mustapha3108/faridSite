package forms


templ CreateMember(){
    <div class="card bg-base-100 w-full max-w-lg mx-auto shadow-xl border border-base-300">
        <div class="card-body">
            <h2 class="card-title text-xl font-bold mb-4">Ajouter un nouveau membre</h2>
            <form
                hx-post="/addMember"
                hx-encoding="multipart/form-data"
                hx-target-error="#res"
                hx-swap="none"
                x-data="{ 
                    name: '', 
                    title: '', 
                    desc: '', 
                    fileName: '',
                    previewUrl: null,
                    handleFile(e) {
                        const file = e.target.files[0];
                        if (file) {
                            this.fileName = file.name;
                            this.previewUrl = URL.createObjectURL(file);
                        } else {
                            this.fileName = '';
                            this.previewUrl = null;
                        }
                    },
                    resetForm() {
                        this.name = '';
                        this.title = '';
                        this.desc = '';
                        this.fileName = '';
                        this.previewUrl = null;
                        this.$refs.fileInput.value = '';
                    }
                }"
                @htmx:after-request="if (detail.successful) { resetForm(); }"
                class="space-y-4"
            >
                <!-- Member Name -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Nom complet</span>
                    </label>
                    <input
                        type="text"
                        name="MemberName"
                        x-model="name"
                        placeholder="ex: Jean Dupont"
                        class="input input-bordered w-full"
                        required
                        minlength="2"
                        maxlength="100"
                    />
                </div>

                <!-- Member Title -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Titre / Poste</span>
                    </label>
                    <input
                        type="text"
                        name="MemberTitle"
                        x-model="title"
                        placeholder="ex: Directrice Technique"
                        class="input input-bordered w-full"
                        maxlength="100"
                    />
                </div>

                <!-- Member Description -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Description</span>
                    </label>
                    <textarea
                        name="MemberDescription"
                        x-model="desc"
                        placeholder="Biographie ou description du membre..."
                        class="textarea textarea-bordered h-28 w-full resize-none"
                        maxlength="2000"
                    ></textarea>
                </div>

                <!-- File Upload (Image) -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Photo de profil</span>
                    </label>
                    
                    <input
                        type="file"
                        name="MemberImage"
                        x-ref="fileInput"
                        @change="handleFile($event)"
                        accept="image/*"
                        class="file-input file-input-bordered file-input-primary w-full"
                        required
                    />

                    <!-- Image Preview Container -->
                    <template x-if="previewUrl">
                        <div class="mt-3 flex items-center gap-3 bg-base-200 p-2 rounded-lg">
                            <div class="avatar">
                                <div class="w-12 h-12 rounded-none ring ring-primary ring-offset-base-100 ring-offset-2">
                                    <img :src="previewUrl" alt="Aperçu" class="object-cover" />
                                </div>
                            </div>
                            <span class="text-xs truncate font-medium text-base-content/70" x-text="fileName"></span>
                        </div>
                    </template>
                </div>

                <!-- Submit Button -->
                <div class="card-actions justify-end pt-4">
                    <button type="submit" class="btn btn-primary w-full">
                        Ajouter le membre
                    </button>
                </div>
            </form>
        </div>
    </div>
}