package forms

import (
    "crow/help/strs"
    "fmt"
)

templ Categories(categories []strs.Category) {
    <div class="w-full max-w-4xl mx-auto space-y-3 p-4">
        for i, c := range categories {
            @categoryAccordion(c, i == 0)
        }
    </div>
}

templ categoryAccordion(c strs.Category, isFirst bool) {
    <div class="collapse bg-base-100 border border-base-300 rounded-box shadow-sm">
        if isFirst {
            <input type="radio" name="category-accordion" checked="checked" />
        } else {
            <input type="radio" name="category-accordion" />
        }

        <!-- Accordion Header -->
        <div class="collapse-title font-semibold flex items-center justify-between pr-8">
            <div class="flex items-center gap-4">
                <div class="avatar">
                    <div class="w-16 h-16 rounded-xl overflow-hidden border border-base-300 shadow-sm shrink-0">
                        if c.ImagePath != "" {
                            <img src={ c.ImagePath } alt={ c.CategoryName } class="object-cover w-full h-full" />
                        } else {
                            <div class="bg-neutral text-neutral-content flex items-center justify-center w-full h-full">
                                <span class="text-xl uppercase font-bold">{ c.CategoryName[:1] }</span>
                            </div>
                        }
                    </div>
                </div>
                <span class="text-lg text-base-content font-bold">{ c.CategoryName }</span>
            </div>
        </div>

        <!-- Accordion Body -->
        <div class="collapse-content text-sm space-y-6 pt-2">
            
            <!-- Update Form -->
            <form
                hx-post="/updateCategory"
                hx-encoding="multipart/form-data"
                hx-target="#res"
                hx-swao="innerHTML"
                class="space-y-4 pt-2 border-t border-base-200"
            >
                <input type="hidden" name="CategoryId" value={ fmt.Sprintf("%d", c.CategoryId) } />
                <input type="hidden" name="ImagePath" value={ c.ImagePath } />

                <!-- Category Name -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Nom de la catégorie</span>
                    </label>
                    <input
                        type="text"
                        name="CategoryName"
                        value={ c.CategoryName }
                        class="input input-bordered input-sm w-full"
                        required
                        minlength="2"
                        maxlength="150"
                    />
                </div>

                <!-- Category Image Upload -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Nouvelle image</span>
                    </label>
                    <input
                        type="file"
                        name="Image"
                        accept="image/*"
                        class="file-input file-input-bordered file-input-primary file-input-sm w-full"
                    />
                </div>

                <div class="flex justify-end pt-2">
                    <button type="submit" class="btn btn-primary btn-sm">
                        Mettre à jour la catégorie
                    </button>
                </div>
            </form>

            <!-- Delete Category -->

            <div class="pt-4 border-t border-base-200 flex justify-end">
                <div x-data="{ confirm: false }">
                    <button
                        type="button"
                        x-show="!confirm"
                        @click="confirm = true"
                        class="btn btn-error btn-outline btn-sm"
                    >
                        Supprimer la categorie
                    </button>

                    <button
                        type="button"
                        x-show="confirm"
                        x-cloak
                        @click="confirm = false"
                        hx-post="/deleteCategory"
                        hx-vals={ fmt.Sprintf(`{"categoryId": "%d"}`, c.CategoryId) }
                        hx-target="closest .collapse"
                        hx-target-error="#res"
                        hx-swap="delete"
                        class="btn btn-accent btn-sm animate-pulse font-bold"
                    >
                        Confirmer la suppression ?
                    </button>
                </div>
            </div>

        </div>
    </div>
}