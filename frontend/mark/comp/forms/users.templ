package forms

import (
    "crow/help/strs"
    "fmt"
    "strings"
)

templ Users(users []strs.User) {
    <div class="w-full max-w-4xl mx-auto space-y-3 p-4">
        for i, u := range users {
            if u.UserId != 1 && u.UserId != 2 {
                @userAccordion(u, i == 0)
            }
        }
    </div>
}

templ createUserForm() {
    <div class="card bg-base-100 w-full max-w-lg mx-auto shadow-xl border border-base-300">
        <div class="card-body">
            <h2 class="card-title text-xl font-bold mb-4">Créer un nouvel utilisateur</h2>

            <form
                hx-post="/createUser"
                hx-target-error="#res"
                hx-swap="none"
                x-data="{ 
                    username: '', 
                    password: '', 
                    roles: [], 
                    get accessString() { return this.roles.join(''); } 
                }"
                @htmx:after-request="if (detail.successful) { username = ''; password = ''; roles = []; }"
                class="space-y-4"
            >
                <!-- Username -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Nom d'utilisateur</span>
                    </label>
                    <input
                        type="text"
                        name="UserName"
                        x-model="username"
                        placeholder="ex: johndoe"
                        class="input input-bordered w-full"
                        required
                        minlength="3"
                        maxlength="50"
                    />
                </div>

                <!-- Password with 12-char limit warning -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Mot de passe (6-12 caractères)</span>
                    </label>
                    <input
                        type="password"
                        name="Password"
                        x-model="password"
                        placeholder="••••••••"
                        class="input input-bordered w-full"
                        required
                        minlength="6"
                        maxlength="12"
                    />
                    <div x-show="password.length >= 12" x-cloak class="label pb-0 pt-1">
                        <span class="label-text-alt text-warning font-medium">⚠️ Limite maximale de 12 caractères atteinte</span>
                    </div>
                </div>

                <!-- Access Rights (cmd) -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Droits d'accès</span>
                    </label>
                    
                    <div class="grid grid-cols-3 gap-2 bg-base-200 p-3 rounded-lg">
                        <label class="label cursor-pointer justify-start gap-2">
                            <input
                                type="checkbox"
                                value="c"
                                x-model="roles"
                                class="checkbox checkbox-primary checkbox-sm"
                            />
                            <span class="label-text">Créer (c)</span>
                        </label>

                        <label class="label cursor-pointer justify-start gap-2">
                            <input
                                type="checkbox"
                                value="m"
                                x-model="roles"
                                class="checkbox checkbox-primary checkbox-sm"
                            />
                            <span class="label-text">Modifier (m)</span>
                        </label>

                        <label class="label cursor-pointer justify-start gap-2">
                            <input
                                type="checkbox"
                                value="d"
                                x-model="roles"
                                class="checkbox checkbox-primary checkbox-sm"
                            />
                            <span class="label-text">Supprimer (d)</span>
                        </label>
                    </div>

                    <input type="hidden" name="Access" :value="accessString" />
                </div>

                <!-- Submit Button -->
                <div class="card-actions justify-end pt-4">
                    <button type="submit" class="btn btn-primary w-full">
                        Créer l'utilisateur
                    </button>
                </div>
            </form>
        </div>
    </div>
}

templ userAccordion(u strs.User, isFirst bool) {
    <div class="collapse bg-base-100 border border-base-300 rounded-box shadow-sm">
        if isFirst {
            <input type="radio" name="user-accordion" checked="checked" />
        } else {
            <input type="radio" name="user-accordion" />
        }

        <!-- Accordion Header -->
        <div class="collapse-title font-semibold flex items-center justify-between pr-8">
            <div class="flex items-center gap-3">
                <div class="avatar placeholder">
                    <div class="bg-neutral text-neutral-content rounded-full w-8">
                        <span class="text-xs uppercase">{ u.UserName[:1] }</span>
                    </div>
                </div>
                <span class="text-base-content font-bold">{ u.UserName }</span>
            </div>
        </div>

        <!-- Accordion Body -->
        <div class="collapse-content text-sm space-y-6 pt-2">
            
            <!-- SECTION 1: Update Username & Access Rights -->
            <form
                hx-post="/updateUser"
                hx-target-error="#res"
                hx-swap="none"
                x-data={ fmt.Sprintf(`{ 
                    roles: %s, 
                    get accessString() { return this.roles.join(''); } 
                }`, parseRolesArray(u.Access)) }
                class="space-y-4 pt-2 border-t border-base-200"
            >
                <input type="hidden" name="UserId" value={ fmt.Sprintf("%d", u.UserId) } />

                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Nom d'utilisateur</span>
                    </label>
                    <input
                        type="text"
                        name="UserName"
                        value={ u.UserName }
                        class="input input-bordered input-sm w-full"
                        required
                        minlength="3"
                        maxlength="50"
                    />
                </div>

                <!-- Access Rights (cmd) -->
                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Droits d'accès</span>
                    </label>
                    
                    <div class="grid grid-cols-3 gap-2 bg-base-200 p-3 rounded-lg">
                        <label class="label cursor-pointer justify-start gap-2">
                            <input
                                type="checkbox"
                                value="c"
                                x-model="roles"
                                class="checkbox checkbox-primary checkbox-sm"
                            />
                            <span class="label-text">Créer (c)</span>
                        </label>

                        <label class="label cursor-pointer justify-start gap-2">
                            <input
                                type="checkbox"
                                value="m"
                                x-model="roles"
                                class="checkbox checkbox-primary checkbox-sm"
                            />
                            <span class="label-text">Modifier (m)</span>
                        </label>

                        <label class="label cursor-pointer justify-start gap-2">
                            <input
                                type="checkbox"
                                value="d"
                                x-model="roles"
                                class="checkbox checkbox-primary checkbox-sm"
                            />
                            <span class="label-text">Supprimer (d)</span>
                        </label>
                    </div>

                    <input type="hidden" name="Access" :value="accessString" />
                </div>

                <div class="flex justify-end pt-1">
                    <button type="submit" class="btn btn-primary btn-sm">
                        Mettre à jour le profil
                    </button>
                </div>
            </form>

            <div class="divider my-0">Changer le mot de passe</div>

            <!-- SECTION 2: Update Password with 12-char limit warning -->
            <form
                hx-post="/updateUserPassword"
                hx-target-error="#res"
                hx-swap="none"
                x-data="{ pass: '' }"
                @htmx:after-request="if (detail.successful) { pass = ''; }"
                class="space-y-4"
            >
                <input type="hidden" name="UserId" value={ fmt.Sprintf("%d", u.UserId) } />

                <div class="form-control w-full">
                    <label class="label pb-1.5">
                        <span class="label-text font-medium">Nouveau mot de passe (6-12 caractères)</span>
                    </label>
                    <div class="flex items-center gap-3">
                        <input
                            type="password"
                            name="Password"
                            x-model="pass"
                            placeholder="••••••••"
                            class="input input-bordered input-sm grow"
                            required
                            minlength="6"
                            maxlength="12"
                        />
                        <button type="submit" class="btn btn-neutral btn-outline btn-sm shrink-0">
                            Modifier le mot de passe
                        </button>
                    </div>
                    <div x-show="pass.length >= 12" x-cloak class="label pb-0 pt-1">
                        <span class="label-text-alt text-warning font-medium">⚠️ Limite maximale de 12 caractères atteinte</span>
                    </div>
                </div>
            </form>

            <!-- SECTION 3: Account Deletion -->
            <div class="pt-4 border-t border-base-200 flex justify-end">
                <div x-data="{ confirm: false }">
                    <button
                        type="button"
                        x-show="!confirm"
                        @click="confirm = true"
                        class="btn btn-error btn-outline btn-sm"
                    >
                        Supprimer le compte
                    </button>

                    <button
                        type="button"
                        x-show="confirm"
                        x-cloak
                        @click="confirm = false"
                        hx-post="/deleteUser"
                        hx-vals={ fmt.Sprintf(`{"userId": "%d"}`, u.UserId) }
                        hx-target="closest .collapse"
                        hx-target-error="#res"
                        hx-swap="delete"
                        class="btn btn-accent btn-sm animate-pulse font-bold"
                    >
                        Confirmer la suppression ?
                    </button>
                </div>
            </div>

        </div>
    </div>
}

func parseRolesArray(access string) string {
    var roles []string
    if strings.Contains(access, "c") { roles = append(roles, "'c'") }
    if strings.Contains(access, "m") { roles = append(roles, "'m'") }
    if strings.Contains(access, "d") { roles = append(roles, "'d'") }
    return "[" + strings.Join(roles, ", ") + "]"
}