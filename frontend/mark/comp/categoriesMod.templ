package comp

import "crow/help/strs"
import "crow/frontend/mark/comp/forms"



templ CategoriesMod(user *strs.User, categories []strs.Category){
    <div class="w-full max-w-4xl mx-auto self-start min-h-screen">
        <div class="tabs tabs-border w-full">

            <input
                type="radio"
                name="my_tabs_2"
                class="tab"
                aria-label="Créer une category"
            />

            <div class="tab-content border-base-300 bg-base-100 p-6 md:p-10">
                @forms.CreateCategory()
            </div>

            <input
                type="radio"
                name="my_tabs_2"
                class="tab"
                aria-label="categories"
                checked="checked"
            />

            <div class="tab-content border-base-300 bg-base-100 p-6 md:p-10">
                @forms.Categories(categories)
            </div>

        </div>
    </div>
}