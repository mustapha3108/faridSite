                    <p class="whitespace-pre-wrap leading-relaxed text-base-content/80">{ c.Message }</p>
                </div>
            </div>

            <!-- Software Skills -->
            if c.Software != "" {
                <div class="space-y-1.5">
                    <p class="text-xs font-semibold uppercase tracking-wider text-base-content/60">Logiciels maîtrisés :</p>
