        if isFirst {
            <input type="radio" name="candidats-accordion" checked="checked" />
        } else {
            <input type="radio" name="candidats-accordion" />
        }
        
        <!-- Header / Title -->
        <div class="collapse-title font-semibold flex items-center justify-between pr-10 py-3.5">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="badge badge-ghost badge-sm">Lu</span>
                <span class="font-bold">{ c.FirstName } { c.LastName }</span>
                <span class="text-xs text-base-content/60 font-normal">({ c.Email })</span>
            </div>
            <span class="text-sm font-normal text-base-content/80 truncate max-w-xs">{ c.Object }</span>
        </div>

        <!-- Content -->
