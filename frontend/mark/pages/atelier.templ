package pages

import(
    "crow/frontend/mark/comp"
    "crow/help/strs"
)

templ Atelier(members []strs.Member){
    @comp.Navbar()
    <div>atelier page</div>
    for _,v := range members {
        @showMembers(v)
    }
}


templ showMembers(m strs.Member) {
    <div class="card bg-base-100 w-96 shadow-sm">
      <figure>
        <img
          src={m.MemberImagePath}
          alt="Shoes" />
      </figure>
      <div class="card-body">
        <h2 class="card-title">{m.MemberName}</h2>
        <h1>{m.MemberTitle}</h1>
        <p>{m.MemberDescription}</p>
      </div>
    </div>
}