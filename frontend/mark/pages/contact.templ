package pages

import (
	"crow/frontend/mark/comp"
	"crow/help/strs"
	"fmt"
	"net/url"
	"regexp"
	"strconv"
	"strings"
)

// dmsToDecimal converts a single DMS match into a float64
func dmsToDecimal(degStr, minStr, secStr, dir string) float64 {
	deg, _ := strconv.ParseFloat(degStr, 64)
	min, _ := strconv.ParseFloat(minStr, 64)
	sec, _ := strconv.ParseFloat(secStr, 64)

	dec := deg + (min / 60.0) + (sec / 3600.0)
	if dir == "S" || dir == "W" {
		dec = -dec
	}
	return dec
}

// parseCoordinates converts DMS format (36°42'56.1"N 3°10'45.5"E) or raw decimal to a clean iframe query
func parseCoordinates(loc string) string {
	loc = strings.TrimSpace(loc)
	if loc == "" {
		return ""
	}

	// Regex for DMS format: 36°42'56.1"N 3°10'45.5"E
	reDMS := regexp.MustCompile(`(\d+)°(\d+)'([\d.]+)"([NS])\s+(\d+)°(\d+)'([\d.]+)"([EW])`)
	matches := reDMS.FindStringSubmatch(loc)

	if len(matches) == 9 {
		lat := dmsToDecimal(matches[1], matches[2], matches[3], matches[4])
		lng := dmsToDecimal(matches[5], matches[6], matches[7], matches[8])
		return fmt.Sprintf("%.6f,%.6f", lat, lng)
	}

	// Fallback to raw input or URL escape if already formatted
	return url.QueryEscape(loc)
}

templ Contact(contact *strs.Contact) {
	@comp.Navbar()
	<div 
		x-data="{ showToast: false, toastMsg: '' }"
		@htmx:after-request.window="if ($event.detail.successful) { showToast = true; toastMsg = 'Opération réussie !'; $event.detail.elt.reset(); setTimeout(() => showToast = false, 4000); }"
		class="min-h-[calc(100vh-4rem)] bg-base-200 py-12 px-4 sm:px-6 lg:px-8 space-y-12 relative"
	>
		<div class="max-w-6xl mx-auto space-y-8">
			
			<!-- Header -->
			<div class="text-center space-y-2">
				<h1 class="text-4xl font-extrabold tracking-tight text-base-content">Contactez-nous</h1>
				<p class="text-base-content/70">N'hésitez pas à nous rendre visite ou à nous envoyer un message.</p>
			</div>

			<!-- Equal height grid for Contact Info & Map -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
				
				<!-- Left Column: Contact Details Card -->
				<div class="card bg-base-100 shadow-xl border border-base-300 flex flex-col justify-between">
					if contact.ImagePath != "" {
                        <div class="hover-3d">
						    <figure class="px-6 pt-6 shrink-0">
						    	<div class="h-64 w-full rounded-xl border border-base-200 bg-base-200/50 p-2 overflow-hidden flex items-center justify-center">
						    		<img
						    			src={ contact.ImagePath }
						    			alt="Carte de visite / Contact Image"
						    			class="h-full w-full object-contain rounded-lg drop-shadow-sm"
						    		/>
						    	</div>
						    </figure>
                             <div></div>
                             <div></div>
                             <div></div>
                             <div></div>
                             <div></div>
                             <div></div>
                             <div></div>
                             <div></div>
                        </div>
					}
					
					<div class="card-body space-y-4 flex-1 flex flex-col justify-between">
						<h2 class="card-title text-2xl font-bold border-b border-base-200 pb-2">Nos Coordonnées</h2>
						
						<div class="space-y-4">
							<!-- Address -->
							if contact.Address != "" || contact.Baladya != "" || contact.Wilaya != "" {
								<div class="flex items-start space-x-3 text-base-content">
									<svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
									<div>
										<p class="font-semibold">Adresse</p>
										<p class="text-sm text-base-content/80">
											{ contact.Address }
											if contact.Baladya != "" {
												, { contact.Baladya }
											}
											if contact.Wilaya != "" {
												, { contact.Wilaya }
											}
										</p>
									</div>
								</div>
							}

							<!-- Email -->
							if contact.Email != "" {
								<div class="flex items-center space-x-3 text-base-content">
									<svg class="w-6 h-6 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
									<div>
										<p class="font-semibold">Email</p>
										<a href={ templ.SafeURL("mailto:" + contact.Email) } class="text-sm text-primary hover:underline">
											{ contact.Email }
										</a>
									</div>
								</div>
							}

							<!-- Phone Number -->
							if contact.Number != "" {
								<div class="flex items-center space-x-3 text-base-content">
									<svg class="w-6 h-6 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
									<div>
										<p class="font-semibold">Téléphone</p>
										<a href={ templ.SafeURL("tel:" + contact.Number) } class="text-sm text-base-content/80 hover:underline">
											{ contact.Number }
										</a>
									</div>
								</div>
							}

							<!-- Fax -->
							if contact.Fax != "" {
								<div class="flex items-center space-x-3 text-base-content">
									<svg class="w-6 h-6 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
									<div>
										<p class="font-semibold">Fax</p>
										<p class="text-sm text-base-content/80">{ contact.Fax }</p>
									</div>
								</div>
							}
						</div>

						<!-- Open External Maps Link Button -->
						if contact.Location != "" {
							<div class="pt-4 mt-auto">
								<a 
									href={ templ.SafeURL("https://www.google.com/maps/search/?api=1&query=" + parseCoordinates(contact.Location)) } 
									target="_blank" 
									rel="noopener noreferrer" 
									class="btn btn-outline btn-primary btn-sm w-full gap-2"
								>
									<span>Ouvrir dans Google Maps</span>
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
								</a>
							</div>
						}
					</div>
				</div>

				<!-- Right Column: Google Map Embed -->
				<div class="card bg-base-100 shadow-xl border border-base-300 overflow-hidden min-h-[480px]">
					if parseCoordinates(contact.Location) != "" {
						<iframe 
							src={ "https://maps.google.com/maps?q=" + parseCoordinates(contact.Location) + "&t=&z=15&ie=UTF8&iwloc=&output=embed" }
							width="100%" 
							height="100%" 
							style="border:0;" 
							allowfullscreen="" 
							loading="lazy" 
							referrerpolicy="no-referrer-when-downgrade"
							class="w-full h-full min-h-[480px]"
						></iframe>
					} else {
						<div class="flex flex-col items-center justify-center h-full bg-base-200 text-base-content/50 space-y-2 p-6 text-center">
							<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
							<p>Aucune localisation enregistrée</p>
						</div>
					}
				</div>

			</div>
		</div>

		<!-- Centered & Compact Form Container -->
		<div class="max-w-2xl mx-auto">
			@ContactForm()
		</div>

		<!-- DaisyUI Toast (Bottom Right) -->
		<div 
			x-show="showToast" 
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 translate-y-4"
			x-transition:enter-end="opacity-100 translate-y-0"
			x-transition:leave="transition ease-in duration-200"
			x-transition:leave-start="opacity-100 translate-y-0"
			x-transition:leave-end="opacity-0 translate-y-4"
			class="toast toast-end toast-bottom z-50"
			style="display: none;"
		>
			<div class="alert alert-success text-white shadow-lg flex items-center gap-2">
				<svg class="w-6 h-6 stroke-current shrink-0" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
				<span x-text="toastMsg"></span>
			</div>
		</div>
	</div>
}

templ ContactForm() {
	<div class="card bg-base-100 shadow-xl border border-base-300">
		<div class="card-body p-6 sm:p-8">
			<div class="text-center space-y-1 mb-2">
				<h2 class="card-title text-2xl font-bold justify-center">
					Envoyez-nous un message
				</h2>
				<p class="text-sm text-base-content/70">
					Une question ? N'hésitez pas à nous contacter.
				</p>
			</div>

			<form
				hx-post="/uploadMessage"
				hx-swap="none"
				class="space-y-4"
			>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div class="form-control">
						<label class="label pb-1" for="FirstName">
							<span class="label-text font-semibold">Prénom</span>
						</label>
						<input
							id="FirstName"
							name="FirstName"
							type="text"
							placeholder="Votre prénom"
							class="input input-bordered input-sm sm:input-md w-full"
							minlength="2"
							maxlength="60"
							required
						/>
					</div>

					<div class="form-control">
						<label class="label pb-1" for="LastName">
							<span class="label-text font-semibold">Nom</span>
						</label>
						<input
							id="LastName"
							name="LastName"
							type="text"
							placeholder="Votre nom"
							class="input input-bordered input-sm sm:input-md w-full"
							minlength="2"
							maxlength="60"
							required
						/>
					</div>
				</div>

				<div class="form-control">
					<label class="label pb-1" for="Email">
						<span class="label-text font-semibold">Email</span>
					</label>
					<input
						id="Email"
						name="Email"
						type="email"
						placeholder="vous@example.com"
						class="input input-bordered input-sm sm:input-md w-full"
						maxlength="100"
						required
					/>
				</div>

				<div class="form-control">
					<label class="label pb-1" for="Object">
						<span class="label-text font-semibold">Objet</span>
					</label>
					<input
						id="Object"
						name="Object"
						type="text"
						placeholder="Objet de votre message"
						class="input input-bordered input-sm sm:input-md w-full"
						minlength="2"
						maxlength="150"
						required
					/>
				</div>

				<div class="form-control">
					<label class="label pb-1" for="Message">
						<span class="label-text font-semibold">Message</span>
					</label>
					<textarea
						id="Message"
						name="Message"
						placeholder="Écrivez votre message..."
						class="textarea textarea-bordered w-full min-h-28 text-sm sm:text-base"
						minlength="5"
						maxlength="3000"
						required
					></textarea>
				</div>

				<div class="pt-2">
					<button
						type="submit"
						class="btn btn-primary w-full"
					>
						Envoyer le message
					</button>
				</div>
			</form>
		</div>
	</div>
}
